{
  "servers": {
    "football-duckdb": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--with",
        "duckdb==2.0.0",
        "--with",
        "mcp==1.9.4",
        "--with",
        "pydantic==2.10.6",
        "--from",
        "mcp-server-duckdb==1.1.0",
        "mcp-server-duckdb",
        "--db-path",
        "${workspaceFolder}/football.duckdb",
        "--readonly"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
